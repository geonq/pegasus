{
  "name": "@pi-gui/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Pegasus for iPhone: follow and steer your Pegasus chats over Tailscale.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios",
    "ios:device": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios --device --configuration Release",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts"
  },
  "dependencies": {
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@legendapp/list": "3.7.2",
    "expo": "58.0.23",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-secure-store": "~58.0.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "file:deps/react-native-enriched-markdown-1.2.0-t3.18-497fbe63.tgz",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "file:deps/react-native-screens-5.0.0-t3.48.tgz",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "typescript": "~5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-screens",
        "react-native-enriched-markdown",
        "react-native-gesture-handler",
        "react-native-worklets"
      ]
    }
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react-native-screens": "*"
      }
    },
    "onlyBuiltDependencies": [
      "react-native-enriched-markdown",
      "react-native-screens"
    ]
  }
}
